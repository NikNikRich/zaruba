# Скопируйте в .env и поправьте под окружение: `Copy-Item .env.example .env`.
# Все переменные читаются pydantic-settings с префиксом ZARUBA_.

# local | prod. В prod включается HSTS; всё остальное одинаково.
ZARUBA_ENV=local

# Домен сайта без схемы: на него Caddy выпускает сертификат Let's Encrypt
# (docker-compose.yml) и по нему же строятся https-адреса. Для VPS задайте,
# например, DOMAIN=zaruba72.ru.
DOMAIN=

# Почта для Let's Encrypt: необязательна, но без неё не будет писем о проблеме
# с продлением сертификата. Раскомментируйте и строку `email` в Caddyfile.
# ACME_EMAIL=admin@example.com

# Публичный адрес сайта: canonical, robots.txt и sitemap.xml. Пусто — берём из
# запроса (тогда обязателен `uvicorn --proxy-headers`). В prod задайте явно:
# он же включает проверку заголовка Host (чужой домен получает 400 и не может
# подменить canonical и sitemap).
# ZARUBA_PUBLIC_BASE_URL=https://zaruba72.ru

# Кэш публичных страниц (§6.20), секунды.
ZARUBA_CACHE_TTL_PUBLIC=60
ZARUBA_CACHE_TTL_SCHEDULE=15

# Бот-проводник в MAX (docs/09 §9.8): отвечает на «расписание», «билеты» и
# прочие слова ссылкой на раздел сайта. Пара токен + секрет — это включатель:
# без любого из них адрес /max/webhook отвечает 404.
# Токен берётся в MAX: «Чат-боты» → ⋮ → «Настройки»; он живёт только здесь.
# ZARUBA_MAX_BOT_TOKEN=
# Секрет подписки, 5–256 символов A–Z a–z 0–9 _ - ; тот же, что в POST /subscriptions.
# ZARUBA_MAX_BOT_SECRET=
# Публичное имя бота — из него собирается кнопка «Открыть в MAX» (open_app).
# ZARUBA_MAX_BOT_NAME=
# Адрес сайта для кнопки-ссылки. Пусто — берётся ZARUBA_PUBLIC_BASE_URL.
# ZARUBA_MAX_BOT_SITE_URL=
# PEM с корневым сертификатом Минцифры: без него TLS-проверка
# platform-api2.max.ru в контейнере падает. Отключать проверку нельзя.
# ZARUBA_MAX_BOT_CA_FILE=/etc/ssl/certs/russian-trust.crt
# Канал или чат рассылки срочных оповещений (docs/09 §9.9): числовой chat_id.
# Пусто — `python -m zaruba.max_notify --send-alerts` ничего не отправляет.
# ZARUBA_MAX_ALERT_CHAT_ID=

# Мониторинг постов сообщества «ЗАРУБА72» (docs/09 §9.13): опрос `wall.get` и
# уведомление в MAX. Токен — включатель: без него `python -m zaruba.vk_watch`
# пишет «проверка пропущена» и выходит с 0. Токен не коммитится, в логах не
# печатается (уходит заголовком Authorization).
# ZARUBA_VK_TOKEN=
# Куда слать посты. Пусто — тот же ZARUBA_MAX_ALERT_CHAT_ID.
# ZARUBA_VK_CHAT_ID=
# Период опроса, секунды, и сколько последних постов читать за цикл.
# ZARUBA_VK_INTERVAL=60
# ZARUBA_VK_POSTS=10

# Фичефлаги (§6.10): включаются только вместе с механикой из docs/05.
# ratings — раздел /ratings индексируется и попадает в sitemap.
# voting — приём голосов (пока механики нет, флаг ничего не открывает).
ZARUBA_RATINGS_ENABLED=false
ZARUBA_FAN_VOTING_ENABLED=false

# Презентационный слой (docs/07): overlay `content/editions/*.d` и два
# демонстрационных рекламных оффера из content/offers.preview.yaml.
# В prod — false: это не факты выпуска и не боевая реклама.
ZARUBA_PREVIEW_ENABLED=false

# Рекламные слоты (§6.27). Не задано — включено в dev и выключено в prod:
# дизайнер видит заглушки, посетитель прод-сайта — только реальные офферы
# из content/offers.yaml. Заглушки в prod не рендерятся ни при каком значении.
# В preview слоты включены независимо от этого флага: на показе нужны примеры.
# ZARUBA_SERVICE_TIPS_ENABLED=false

# Пути к контенту нужны только при установке пакета в site-packages (Docker):
# по умолчанию они считаются от корня репозитория.
# ZARUBA_CONTENT_DIR=/app/content/editions
# ZARUBA_VENUES_FILE=/app/content/venues.yaml
# ZARUBA_GLOSSARY_FILE=/app/content/glossary.yaml
# ZARUBA_FAQ_FILE=/app/content/faq.yaml
# ZARUBA_HISTORY_FILE=/app/content/history.yaml
# ZARUBA_PHOTOS_FILE=/app/content/photos.yaml
# ZARUBA_OFFERS_FILE=/app/content/offers.yaml
# ZARUBA_OFFERS_PREVIEW_FILE=/app/content/offers.preview.yaml

# Кому доверять в X-Forwarded-* (uvicorn --proxy-headers). За прокси — адрес прокси.
FORWARDED_ALLOW_IPS=127.0.0.1
