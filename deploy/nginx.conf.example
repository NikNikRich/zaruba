# Пример конфигурации nginx перед uvicorn (`docs/06` §6.20).
# Задачи: HTTPS, сжатие, кэш статики и проброс X-Forwarded-Proto.
# Без `X-Forwarded-Proto` canonical, robots.txt и sitemap будут отдавать
# http://127.0.0.1:8000 — приложению нужен `--proxy-headers`.

server {
    listen 80;
    server_name example.ru www.example.ru;
    return 301 https://example.ru$request_uri;
}

# www — тот же сайт. Без этого блока https://www.example.ru открывается, а не
# перенаправляет: два хоста с одинаковым контентом, и canonical приходится
# объяснять роботу вместо того, чтобы просто отдать 301.
server {
    listen 443 ssl;
    http2 on;
    server_name www.example.ru;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    return 301 https://example.ru$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name example.ru;

    # Версия nginx в заголовке `Server` — подсказка для подбора эксплойта.
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # HSTS уже отдаёт приложение в prod (ZARUBA_ENV=prod); дублировать не нужно.

    # Ограничение частоты — единственное, чего у приложения нет из коробки:
    # один процесс и `--limit-concurrency 64` держат всплеск, но не поток
    # запросов с одного адреса. Зона объявляется в блоке `http`:
    #   limit_req_zone $binary_remote_addr zone=zaruba:10m rate=10r/s;
    # 10 r/s с burst 20 — это в разы больше, чем нужно человеку: у сайта нет
    # ни форм, ни API, только страницы. `/healthz` сюда не попадает (см. ниже).
    # limit_req zone=zaruba burst=20 nodelay;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/xml application/xml application/json image/svg+xml;

    client_max_body_size 1m;

    # `/healthz` наружу не нужен: он называет версию и окружение, а нужен
    # только healthcheck-у контейнера и мониторингу на том же хосте.
    location = /healthz {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # приложение уже отдаёт Cache-Control: public, max-age=3600
        expires 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Номер запроса: приложение вернёт его в ответе и запишет в журнал,
        # поэтому по номеру из письма посетителя находится и запись nginx.
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }
}
