__pycache__/
*.py[cod]
.venv/
venv/
# Любые файлы окружения с секретами: в репозитории только шаблон.
# Копия вида `zaruba.env` с живым токеном бота уже появлялась в рабочей папке —
# шаблон `*.env` закрывает такие имена целиком, а не только `.env`.
.env
*.env
# Варианты с суффиксом (`.env.local`, `.env.prod`) — тот же секрет, другое имя.
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
node_modules/
*.egg-info/
build/
dist/
# Исходники фото (большие файлы): в репозиторий идут только готовые превью
# из `src/zaruba/static/img/`, которые делает `tools/prepare_photos.py`.
assets/photos/*
!assets/photos/README.md
# Логи локального запуска (uvicorn и прочее) — не для репозитория
.run_*.txt
# Журналы бота на домашнем ПК (`deploy/local-pc/run_bot_loop.ps1`): ротация
# оставляет до LogMaxMB×LogKeepFiles мегабайт, в git им делать нечего.
logs/
# Служебные файлы ОС: их создаёт Explorer/Finder, в репозитории им делать нечего
.DS_Store
Thumbs.db
# Презентационная сборка `scripts/build_static_preview.py`:
# архив и единый HTML уходят руководству через мессенджер, а не в git,
# рабочая папка — мусор.
*.zip
.preview-build/
zaruba_2026_preview.html

